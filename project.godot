; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Swamp Horror Simulator 3D"
config/version="1.3.13"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.8", "GL Compatibility")
config/icon="res://assets/icons/onion_icon.png"

[autoload]

GameState="*res://scripts/game_state.gd"
SettingsBus="*res://scripts/settings_bus.gd"

[display]

window/size/viewport_height=864
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="sensor_landscape"

